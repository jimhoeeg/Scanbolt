# --- Server ---
PORT=4000
NODE_ENV=development

# --- PostgreSQL ---
# Relational integrity is crucial for machine-to-part mapping.
DATABASE_URL=postgres://scanbolt:scanbolt@localhost:5432/scanbolt

# --- Auth (MODULE 1) ---
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h

# --- ERP simulation (MODULE 4) ---
# In production these would point at Microsoft Business Central / OData.
ERP_BASE_URL=https://api.businesscentral.dynamics.com/v2.0/simulated
ERP_ENABLED=false
